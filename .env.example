NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/content_risk_checker?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/content_risk_checker_shadow?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379

WORKER_CONCURRENCY=5

# LLM via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=content-risk-checker
OPENROUTER_APP_URL=http://localhost:3000
LLM_MODEL=anthropic/claude-opus-4-5
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=2048
LLM_VALIDATION_MAX_ATTEMPTS=2

# AI memory (similar-case retrieval for few-shot prompting). Requires pgvector.
AI_MEMORY_ENABLED=true
AI_MEMORY_TOP_N=3
AI_MEMORY_MIN_SIMILARITY=0.85
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_TIMEOUT_MS=10000

LOG_LEVEL=info
LOG_PRETTY=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

CORS_ORIGINS=http://localhost:5173
