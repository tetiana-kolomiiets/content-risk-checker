{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "e2e\\.e2e-spec\\.ts$|/e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/jest.env.ts"],
  "globalSetup": "<rootDir>/jest.global-setup.ts",
  "testTimeout": 30000
}
