{
  "name": "content-risk-checker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend:dev": "cd apps/backend && nest start --watch",
    "backend:build": "cd apps/backend && nest build",
    "backend:test": "cd apps/backend && jest",
    "backend:test:e2e": "cd apps/backend && jest --config test/jest-e2e.json --runInBand",
    "backend:lint": "cd apps/backend && eslint \"src/**/*.ts\" --fix",
    "frontend:dev": "cd apps/frontend && vite",
    "frontend:build": "cd apps/frontend && tsc -b && vite build",
    "frontend:lint": "cd apps/frontend && eslint .",
    "dev": "concurrently -n api,web -c blue,green \"npm:backend:dev\" \"npm:frontend:dev\"",
    "prisma:generate": "cd apps/backend && prisma generate",
    "prisma:migrate": "cd apps/backend && prisma migrate dev",
    "prisma:seed": "cd apps/backend && prisma db seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
